#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temp_root="$(mktemp -d)"

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  exit 1
}

assert_mode() {
  local expected="$1"
  local path="$2"
  [[ "$(stat -c '%a' "$path")" == "$expected" ]] ||
    fail "$path mode is not $expected"
}

# shellcheck source=../lib/private-io.sh
source "$repo_root/lib/private-io.sh"
private_io_init
private_prepare_report "$temp_root/private/report.txt"
assert_mode 700 "$temp_root/private"
assert_mode 600 "$temp_root/private/report.txt"
[[ "$(private_redact "fixture-value" "before fixture-value after")" == "before [REDACTED] after" ]] ||
  fail "redaction failed"

fake_bin="$temp_root/bin"
mkdir -p "$fake_bin"
cat >"$fake_bin/curl" <<'CURL_STUB'
#!/usr/bin/env bash
set -Eeuo pipefail
tr '\0' ' ' <"/proc/$$/cmdline" >"$PROCESS_CAPTURE"
cat >/dev/null
CURL_STUB
chmod 0700 "$fake_bin/curl"

secret="fixture-token-never-disclose"
exec 9<<<"$secret"
PATH="$fake_bin:$PATH" PROCESS_CAPTURE="$temp_root/process.txt" CIVIT_API_FD=9 \
  bash -x "$repo_root/CIVIT_Download.sh" "https://example.test/model" \
  >"$temp_root/download.out" 2>"$temp_root/download.trace"
exec 9<&-
for evidence in "$temp_root/process.txt" "$temp_root/download.out" "$temp_root/download.trace"; do
  ! grep -Fq "$secret" "$evidence" || fail "secret leaked into $evidence"
done

rm -rf "$temp_root"
printf 'Secret tests passed.\n'
